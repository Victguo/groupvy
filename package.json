{
  "name": "groupvy",
  "version": "0.1.0",
  "description": "Swipe with your partner or group to find something you all agree on.",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c blue,green \"nodemon server.js\" \"vite\"",
    "build": "vite build",
    "start": "node server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"client/src/**/*.scss\"",
    "lint:css:fix": "stylelint \"client/src/**/*.scss\" --fix"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "nodemon": "^3.1.4",
    "sass": "^1.103.1",
    "stylelint": "^16.11.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "vite": "^5.4.0"
  }
