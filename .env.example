# Get a free API key at https://www.themoviedb.org/settings/api (v3 auth key)
# Without this, the movie deck falls back to the small hardcoded list in data/decks.js
TMDB_API_KEY=

# Get a free API key at https://www.yelp.com/developers/v3/manage_app
# Without this, the dinner deck falls back to the small hardcoded list in data/decks.js
YELP_API_KEY=
# City/region Yelp should search restaurants in, e.g. "San Francisco, CA". Defaults to "New York, NY".
YELP_LOCATION=
