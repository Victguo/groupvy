# Get a free API key at https://www.themoviedb.org/settings/api (v3 auth key)
# Without this, the movie deck falls back to the small hardcoded list in data/decks.js
TMDB_API_KEY=

# Enable "Places API (New)" on a Google Cloud project (needs billing enabled, but the
# free monthly credit comfortably covers normal usage) and create an API key at
# https://console.cloud.google.com/google/maps-apis/credentials
# Note this is the NEW Places API, not the legacy "Places API" — enabling the wrong one
# makes every dinner search fail.
# Without this, the dinner deck falls back to the small hardcoded list in data/decks.js
GOOGLE_PLACES_API_KEY=
# City/region to search when the room creator won't share their location,
# e.g. "San Francisco, CA". Defaults to "Newmarket, ON".
GOOGLE_PLACES_LOCATION=
